{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-subagent.py",
            "timeout": 10,
            "description": "验证子代理调用合法性"
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/update-progress.py",
            "timeout": 5,
            "description": "更新工作流进度（仅限特定代理）"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/track-file.py",
            "timeout": 5,
            "description": "跟踪所有文件变更"
          }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/capture-approval.py",
            "timeout": 5,
            "description": "捕获用户审批决策"
          }
        ]
      }
    ]
  }
}
